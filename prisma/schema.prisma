generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Group {
  id            String   @id @default(cuid())
  name          String
  inviteCode    String   @unique
  alarmTime     String?
  startPoints   Int
  penaltyPoints Int
  meetupLat     Float?
  meetupLng     Float?
  meetupRadiusM Int      @default(100)
  members       Member[]
  clips         Clip[]
  wakeCalls     WakeCall[]
}

model Member {
  id            String       @id @default(cuid())
  groupId       String
  group         Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  nickname      String
  points        Int
  responses     Response[]
  penaltyLogs   PenaltyLog[]
  clipsSent     Clip[]       @relation("ClipFrom")
  clipsReceived Clip[]       @relation("ClipTo")
  wakeSent      WakeCall[]   @relation("WakeFrom")
  wakeReceived  WakeCall[]   @relation("WakeTo")

  @@unique([groupId, nickname])
  @@unique([groupId, userId])
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  members      Member[]
  sessions     AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Response {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      String
  choice    String
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@unique([memberId, date])
}

model Clip {
  id           String   @id @default(cuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   Member   @relation("ClipFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMemberId   String?
  toMember     Member?  @relation("ClipTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  filePath     String
  mimeType     String
  hasVideo     Boolean
  createdAt    DateTime @default(now())
  usedDate     String?
}

model PenaltyLog {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date     String
  points   Int
  reason   String

  @@unique([memberId, date])
}

model WakeCall {
  id           String    @id @default(cuid())
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   Member    @relation("WakeFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMemberId   String
  toMember     Member    @relation("WakeTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  ackedAt      DateTime?
}
